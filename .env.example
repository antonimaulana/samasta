APP_NAME="SIMTAMAN"
APP_FULL_NAME="Sistem Informasi Manajemen Pertamanan"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta
APP_FAKER_LOCALE=en_US

ALERT_BIBIT_MIN_STOCK=10
ALERT_ADUAN_UNREVIEWED_DAYS=3
ALERT_LAYANAN_DIPROSES_DAYS=7

# Email ringkasan operasional harian (butuh MAIL_* dikonfigurasi)
OPERATIONAL_DIGEST_ENABLED=false
OPERATIONAL_DIGEST_RECIPIENTS=

# Akun admin awal (hanya untuk local/staging — wajib set password kuat, min. 12 karakter)
# Production: jangan jalankan db:seed; buat admin manual via tinker/CLI
ADMIN_NAME="Administrator SIMTAMAN"
ADMIN_EMAIL=admin@sitaman.batam
ADMIN_PASSWORD=

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Kegiatan lapangan panjang: SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production: SESSION_ENCRYPT=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Production mail example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.domain.go.id
# MAIL_PORT=587
# MAIL_USERNAME=notifikasi@domain.go.id
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS=notifikasi@domain.go.id
# OPERATIONAL_DIGEST_ENABLED=true
# OPERATIONAL_DIGEST_RECIPIENTS=ops@domain.go.id,admin@domain.go.id

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Geocoder wilayah taman (reverse geocode koordinat → kelurahan/kecamatan via OpenStreetMap Nominatim)
WILAYAH_GEOCODER_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT="SIMTAMAN Geocoder"

# Input lapangan tanpa login — petugas cukup memasukkan PIN sekali per sesi
SIMTAMAN_LAPANGAN_PIN=
SIMTAMAN_LAPANGAN_SESSION_TTL=480
# Alias lama (opsional, untuk kompatibilitas deployment):
# SIMAPAN_LAPANGAN_PIN=
# SIMAPAN_LAPANGAN_SESSION_TTL=480

# Backup (production VPS)
# BACKUP_PATH=/var/backups/samasta
# BACKUP_KEEP_DAYS=30
# BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump

# Deploy checklist:
# 1. php artisan migrate --force
# 2. php artisan db:seed --class=WilayahBatamSeeder
# 3. php artisan db:seed --class=TimPelaksanaSeeder
# 4. php artisan storage:link
# 5. npm run build
# 6. php artisan tamans:assign-kelurahan-from-coordinates  (opsional, backfill taman lama)
# 7. Cron: * * * * * php artisan schedule:run
# 8. Queue worker jika QUEUE_CONNECTION=database
# 9. Pastikan PHP extension GD aktif (export PDF)
# 10. trustProxies sudah aktif di bootstrap/app.php (Cloudflare)
