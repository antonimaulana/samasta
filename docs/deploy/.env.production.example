# =============================================================================
# SIMTAMAN — Environment Production
# Salin ke server sebagai .env (JANGAN commit file .env ke Git)
# =============================================================================

APP_NAME="SIMTAMAN"
APP_FULL_NAME="Sistem Informasi Manajemen Pertamanan"
APP_ENV=production
APP_KEY=                          # php artisan key:generate
APP_DEBUG=false
APP_URL=https://sitaman.batam.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_TIMEZONE=Asia/Jakarta

# --- Keamanan session ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

# --- Database (MySQL/MariaDB — disarankan Kominfo) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sitaman_batam
DB_USERNAME=sitaman_app
DB_PASSWORD=

# --- Cache, queue, log ---
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Email (SMTP Pemda / Kominfo) ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.batam.go.id
MAIL_PORT=587
MAIL_USERNAME=notifikasi@sitaman.batam.go.id
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifikasi@sitaman.batam.go.id
MAIL_FROM_NAME="${APP_NAME}"

# --- Digest operasional harian (opsional) ---
OPERATIONAL_DIGEST_ENABLED=true
OPERATIONAL_DIGEST_RECIPIENTS=ops@disperakimtan.batam.go.id

# --- Alert thresholds ---
ALERT_BIBIT_MIN_STOCK=10
ALERT_ADUAN_UNREVIEWED_DAYS=3
ALERT_LAYANAN_DIPROSES_DAYS=7

# --- Geocoder (koordinat → kelurahan via OpenStreetMap) ---
# Set false jika server tidak diizinkan akses internet keluar
WILAYAH_GEOCODER_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT="SIMTAMAN Geocoder (Disperakimtan Kota Batam)"

# --- Admin: JANGAN isi di production — buat akun via php artisan tinker ---
# ADMIN_NAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

BCRYPT_ROUNDS=12
VITE_APP_NAME="${APP_NAME}"
